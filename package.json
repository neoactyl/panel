{
  "name": "neoactyl",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "bot": "bun scripts/discord-bot.ts",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "auth:schema": "auth generate --config src/lib/server/auth/auth.ts --output src/lib/server/db/auth.schema.ts --yes",
    "ui:add": "bun x shadcn-svelte@latest add",
    "stripe:forward": "stripe listen --events checkout.session.completed,checkout.session.async_payment_succeeded --forward-to localhost:5173/api/auth/stripe/webhook",
    "bot:run": "bun scripts/discord-bot"
  },
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*"
  },
  "dependencies": {
    "@better-auth/stripe": "^1.7.12",
    "@libsql/client": "^0.17.3",
    "@t3-oss/env-core": "^0.13.11",
    "auth": "^1.6.24",
    "better-auth": "^1.6.24",
    "discord.js": "^14.27.0",
    "drizzle-orm": "^0.45.2",
    "stripe": "^23.0.1",
    "sveltekit-rate-limiter": "^0.8.0",
    "sveltekit-superforms": "^3.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@internationalized/date": "^3.12.0",
    "@sveltejs/adapter-auto": "^8.0.0",
    "@sveltejs/kit": "^3.0.0",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@tabler/icons-svelte": "^3.49.0",
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^26",
    "bits-ui": "^2.20.0",
    "cn": "^0.3.0",
    "drizzle-kit": "^0.31.10",
    "layerchart": "^2.0.0",
    "shadcn-svelte": "^1.7.0",
    "shiki": "^3.20.0",
    "svelte": "^5.57.1",
    "svelte-check": "^4.6.0",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.3.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.5"
  }
}
