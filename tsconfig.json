{
	"extends": "$app/tsconfig",
	"compilerOptions": {
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"noImplicitOverride": true,
		"noFallthroughCasesInSwitch": true,
		"forceConsistentCasingInFileNames": true,
		"types": [
			"$app/types",
			"node"
		]
	},
	"include": [
		"src",
		"vite.config.ts",
		"drizzle.config.ts"
	]
}
