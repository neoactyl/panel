# Drizzle
DATABASE_URL=file:local.db
# Optional, only needed when DATABASE_URL points at a networked libSQL/Turso
# database that requires an auth token (also required by separately hosted bot
# processes).
DATABASE_AUTH_TOKEN=""

ORIGIN=""

# Better Auth
# Base URL of your app. Defaults to ORIGIN when unset.
BETTER_AUTH_URL=""
# For production use 32 characters and generated with high entropy
# https://www.better-auth.com/docs/installation
BETTER_AUTH_SECRET=""

# Panel adapter, branding, quotas, registration, navigation, and feature flags
# are stored in the database and configured from /admin after first-run setup.

# Encrypts panel API tokens at rest with AES-256-GCM (32+ random characters).
# Falls back to BETTER_AUTH_SECRET when unset, but a dedicated key is recommended.
SETTINGS_ENCRYPTION_KEY=""
# Stripe credit top-up (optional; the admin Settings page overrides these)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Optional Discord bot overrides. The embedded invite bot also reads its token
# and primary guild ID from /admin Settings.
DISCORD_BOT_TOKEN=""
DISCORD_GUILD_ID=""

# Embedded invite bot process layout.
# The web process runs shard 0 by default. Set DISCORD_EMBED_BOT=false when the
# bot is hosted separately, and give each separate process the same
# DISCORD_SHARD_COUNT with a different (disjoint) DISCORD_SHARD_IDS value.
# Sharding is only necessary for very large bots and every shard must be online.
DISCORD_EMBED_BOT="true"
DISCORD_SHARD_COUNT="1"
DISCORD_SHARD_IDS="0"
