# Drizzle
DATABASE_URL=file:local.db

ORIGIN=""

# Better Auth
# Base URL of your app. Defaults to ORIGIN when unset.
BETTER_AUTH_URL=""
# For production use 32 characters and generated with high entropy
# https://www.better-auth.com/docs/installation
BETTER_AUTH_SECRET=""

# Panel adapter, branding, quotas, registration, navigation, and feature flags
# are stored in the database and configured from /admin after first-run setup.

# Encrypts panel API tokens at rest with AES-256-GCM (32+ random characters).
# Falls back to BETTER_AUTH_SECRET when unset, but a dedicated key is recommended.
SETTINGS_ENCRYPTION_KEY=""